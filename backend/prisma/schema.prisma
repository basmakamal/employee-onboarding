// Prisma schema — HR System (BRD v2)
// Stage 1: Trainee Management · Stage 2: Employee File · Stage 3: Offboarding

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Staff role groups — each workflow status is owned by a group (machine
/// transitions declare `roles`); ADMIN overrides everything. Trainees and
/// employees are NOT users — they act through signed link tokens.
enum Role {
  HR // trainee stage, criminal record, offboarding flow
  INSURANCE // GOSI + medical insurance cards
  IT // asset registry + custody forms
  FINANCE // final settlement + file closure
  ADMIN
}

/// One lifecycle for the whole journey (BRD stages 1–3): the onboarding
/// pipeline (CREATED → … → AWAITING_CONTRACT_APPROVAL, with EXPIRED/reopen),
/// then employment (ACTIVE → INACTIVE). The employee number is allocated
/// only on activation, so expired candidates never get one.
enum EmployeeStatus {
  CREATED
  AWAITING_FORM
  FORM_RECEIVED
  CONTRACT_CREATION
  AWAITING_CONTRACT_APPROVAL
  EXPIRED
  ACTIVE
  INACTIVE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  TEMPORARY
}

/// Collected on the employee data form; required on every employment contract.
enum Gender {
  MALE
  FEMALE
}

/// Arabic renders these gendered (أعزب / عزباء), resolved in the UI from Gender.
enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum EducationLevel {
  HIGH_SCHOOL
  DIPLOMA
  BACHELOR
  MASTER
  PHD
  OTHER
}

/// HR services requested from the employee profile (BRD "الطلبات والخدمات").
/// A simple log for now — each request records who asked for what and when;
/// dedicated approval workflows can grow out of individual types later.
enum EmployeeRequestType {
  SALARY_LETTER
  BANK_LETTER
  DEPARTMENT_CHANGE
  JOB_TITLE_CHANGE
  PROMOTION
  PROJECT_TRANSFER
  WARNING
  INVESTIGATION
}

/// GOSI + Medical Insurance share this lifecycle.
enum ProcessStatus {
  PENDING
  DONE
  ON_HOLD
  CANCELLED
}

enum GosiHoldReason {
  OPTIONAL_SUBSCRIPTION
  GOVERNMENT_EMPLOYEE
  DOB_MISMATCH
  ID_MISMATCH
  INCOMPLETE_DATA
  OTHER
}

enum MedicalHoldReason {
  ELM_DATA_ISSUE
  OTHER_INSURANCE_EXISTS
  EMPLOYEE_DECLINED
  AWAITING_INSURER
  INCOMPLETE_DATA
  OTHER
}

enum CriminalRecordStatus {
  TRAINING
  REQUEST_SENT
  PENDING
  DONE
}

enum AssetFormStatus {
  DRAFT
  SENT
  PENDING_EMPLOYEE_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum AssetCondition {
  NEW
  USED
}

enum OffboardingReason {
  RESIGNATION
  TERMINATION
  CONTRACT_EXPIRY
  RETIREMENT
  DEATH
}

enum OffboardingStatus {
  REQUESTED
  IN_PROGRESS
  ASSETS_PENDING
  NOTICE_SENT
  SETTLEMENT
  CLOSED
  CANCELLED
}

enum LinkPurpose {
  DATA_FORM
  CONTRACT_APPROVAL
  ASSET_APPROVAL
  EXIT_INTERVIEW
}

enum SlaUnit {
  HOURS
  CALENDAR_DAYS
  WORKING_DAYS
}

enum SlaAction {
  REMIND
  REMIND_DAILY
  ESCALATE
  EXPIRE
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ---------------------------------------------------------------------------
// Staff
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         Role
  passwordHash String? // set in Phase F (auth)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  employeesCreated    Employee[]    @relation("EmployeeCreatedBy")
  contractsCreated    Contract[]
  assetFormsCreated   AssetForm[]
  offboardingRequests Offboarding[] @relation("OffboardingRequestedBy")
  auditEntries        AuditLog[]
  notifications       Notification[]
  employeeRequests    EmployeeRequest[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// The Employee — one record for the whole journey (BRD stages 1–3)
// ---------------------------------------------------------------------------

model Employee {
  id             String         @id @default(cuid())
  /// e.g. EMP-0001 — allocated when the employee becomes ACTIVE, never before.
  employeeNo     String?        @unique
  /// الاسم الرباعي — kept as four parts because contracts, GOSI and Absher
  /// all expect them separately, and splitting a single string later is
  /// guesswork. firstName/lastName remain the display pair.
  firstName        String
  fatherName       String?
  grandfatherName  String?
  lastName         String
  email            String         @unique
  phone            String?
  nationalId       String?
  /// Gregorian — the value every downstream system (contract, GOSI) needs.
  birthDate        DateTime?
  /// The Hijri date the employee actually entered, kept verbatim (e.g.
  /// 1400-05-12) so what HR reads back matches what was typed. birthDate is
  /// the converted equivalent; this is the source of truth for display.
  birthDateHijri   String?
  gender           Gender?
  nationality      String?
  maritalStatus    MaritalStatus?
  /// العنوان الوطني المختصر (سبل) — 4 letters + 4 digits, e.g. RRRD2929.
  splAddress       String?
  /// Saudi IBAN: SA + 22 digits. Validated with the mod-97 checksum on entry
  /// so a mistyped digit surfaces at the form, not at payroll.
  iban             String?
  qualification    EducationLevel?
  major            String?
  emergencyContactName  String?
  emergencyContactPhone String?
  department     String?
  project        String?
  jobTitle       String?
  directManager  String?
  employmentType EmploymentType @default(FULL_TIME)
  photoKey       String? // storage key of the profile photo (UPLOAD_DIR)
  /// Set on activation (contract approval or direct add of existing staff).
  hireDate       DateTime?
  status         EmployeeStatus @default(CREATED)

  /// SLA anchor: every transition updates this; the scheduler measures from it.
  statusChangedAt DateTime @default(now())

  createdBy   User?   @relation("EmployeeCreatedBy", fields: [createdById], references: [id])
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents       OnboardingDocument[]
  contract        Contract?
  gosi            GosiProcess?
  medical         MedicalInsuranceProcess?
  criminalRecord  CriminalRecordProcess?
  assetForms      AssetForm[]
  offboardings    Offboarding[]
  linkTokens      LinkToken[]
  expiryDocuments EmployeeDocument[]
  requests        EmployeeRequest[]
  auditLogs       AuditLog[]               @relation("EmployeeAudit")

  @@index([status])
  @@map("employees")
}

/// One row per onboarding checklist item. HR configures the checklist;
/// the new hire's signed-link upload fills the row. A row without
/// storageKey is a missing document.
model OnboardingDocument {
  id         String    @id @default(cuid())
  employee   Employee  @relation(fields: [employeeId], references: [id])
  employeeId String
  type       String // e.g. NATIONAL_ID, QUALIFICATION, IBAN_LETTER — HR-configurable
  label      String? // display label if type is custom
  required   Boolean   @default(true)
  storageKey String?
  mimeType   String?
  sizeBytes  Int?
  uploadedAt DateTime?
  notes      String?

  @@unique([employeeId, type])
  @@map("onboarding_documents")
}

model Contract {
  id          String    @id @default(cuid())
  employee    Employee  @relation(fields: [employeeId], references: [id])
  employeeId  String    @unique
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdById String
  storageKey  String? // generated/uploaded contract document
  details     Json? // salary, duration, terms
  sentAt      DateTime?
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("contracts")
}

/// One HR service requested from the profile (salary letter, promotion,
/// warning…). Plain log entries — see EmployeeRequestType.
model EmployeeRequest {
  id          String              @id @default(cuid())
  employee    Employee            @relation(fields: [employeeId], references: [id])
  employeeId  String
  type        EmployeeRequestType
  notes       String?             @db.Text
  createdBy   User                @relation(fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime            @default(now())

  @@index([employeeId])
  @@map("employee_requests")
}

model GosiProcess {
  id         String          @id @default(cuid())
  employee   Employee        @relation(fields: [employeeId], references: [id])
  employeeId String          @unique
  status     ProcessStatus   @default(PENDING)
  holdReason GosiHoldReason?
  holdNote   String?
  updatedAt  DateTime        @updatedAt
  createdAt  DateTime        @default(now())

  @@map("gosi_processes")
}

model MedicalInsuranceProcess {
  id         String             @id @default(cuid())
  employee   Employee           @relation(fields: [employeeId], references: [id])
  employeeId String             @unique
  status     ProcessStatus      @default(PENDING)
  holdReason MedicalHoldReason?
  holdNote   String?
  updatedAt  DateTime           @updatedAt
  createdAt  DateTime           @default(now())

  @@map("medical_insurance_processes")
}

model CriminalRecordProcess {
  id                    String               @id @default(cuid())
  employee              Employee             @relation(fields: [employeeId], references: [id])
  employeeId            String               @unique
  status                CriminalRecordStatus @default(TRAINING)
  certificateStorageKey String?
  updatedAt             DateTime             @updatedAt
  createdAt             DateTime             @default(now())

  @@map("criminal_record_processes")
}

// ---------------------------------------------------------------------------
// Assets (registry + custody forms)
// ---------------------------------------------------------------------------

/// Company asset registry. Serial-numbered assets are unique; bulk items
/// (cables, accessories) may have no serial.
model Asset {
  id           String   @id @default(cuid())
  type         String // e.g. LAPTOP, HEADPHONE, PHONE, ACCESS_CARD
  name         String
  serialNumber String?  @unique
  notes        String?
  createdAt    DateTime @default(now())

  formItems AssetFormItem[]

  @@index([type])
  @@map("assets")
}

model AssetForm {
  id           String          @id @default(cuid())
  employee     Employee        @relation(fields: [employeeId], references: [id])
  employeeId   String
  createdBy    User            @relation(fields: [createdById], references: [id])
  createdById  String
  status       AssetFormStatus @default(DRAFT)
  deliveryDate DateTime?
  sentAt       DateTime?
  decidedAt    DateTime? // employee approved/rejected at
  rejectReason String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  items      AssetFormItem[]
  linkTokens LinkToken[]

  @@index([employeeId])
  @@map("asset_forms")
}

model AssetFormItem {
  id           String         @id @default(cuid())
  form         AssetForm      @relation(fields: [formId], references: [id])
  formId       String
  /// Optional link into the registry (enforces unique serial ownership).
  asset        Asset?         @relation(fields: [assetId], references: [id])
  assetId      String?
  type         String
  name         String
  serialNumber String?
  quantity     Int            @default(1)
  condition    AssetCondition @default(NEW)
  notes        String?
  returnedAt   DateTime? // set during offboarding asset return

  @@index([formId])
  @@map("asset_form_items")
}

// ---------------------------------------------------------------------------
// Stage 3 — Offboarding
// ---------------------------------------------------------------------------

model Offboarding {
  id         String            @id @default(cuid())
  employee   Employee          @relation(fields: [employeeId], references: [id])
  employeeId String
  reason     OffboardingReason
  status     OffboardingStatus @default(REQUESTED)
  notes      String?

  requestedBy   User   @relation("OffboardingRequestedBy", fields: [requestedById], references: [id])
  requestedById String

  // Exit interview (auto-sent only for RESIGNATION)
  exitInterviewSentAt      DateTime?
  exitInterviewCompletedAt DateTime?
  exitInterviewData        Json?

  // Asset return gate
  assetsConfirmedAt   DateTime?
  assetsConfirmedById String?

  // Termination notice
  noticeSentAt     DateTime?
  noticeStorageKey String?

  // Final settlement (amounts entered by HR)
  settlementWorkingDays  Int?
  settlementLeaveDays    Decimal?  @db.Decimal(6, 2)
  settlementDeductions   Decimal?  @db.Decimal(12, 2)
  settlementEntitlements Decimal?  @db.Decimal(12, 2)
  settlementNotes        String?
  settlementApprovedById String?
  settlementApprovedAt   DateTime?

  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  linkTokens LinkToken[]

  @@index([employeeId])
  @@index([status])
  @@map("offboardings")
}

// ---------------------------------------------------------------------------
// SLA engine (config-driven timers) + working-day support
// ---------------------------------------------------------------------------

/// One row per BRD automation rule, editable by admins. The scheduler
/// evaluates active rules against records sitting in `status` for longer
/// than `afterValue afterUnit` (measured from statusChangedAt).
model SlaRule {
  id            String    @id @default(cuid())
  processKey    String    @default("EMPLOYEE") // which state machine this targets
  status        String // the status the record must be in
  afterValue    Int
  afterUnit     SlaUnit
  action        SlaAction
  notifySubject Boolean   @default(true) // the employee / new hire
  notifyHr      Boolean   @default(true) // legacy flag; notifyRole is the target
  /** Staff group that receives the reminder. */
  notifyRole    String    @default("HR")
  /** ESCALATE only: the higher group that gets the escalation. */
  escalateToRole String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())

  firings SlaFiring[]

  @@index([processKey, status, active])
  @@map("sla_rules")
}

/// One row per rule execution against a record — the scheduler's memory.
/// REMIND/ESCALATE fire once per (rule, record); REMIND_DAILY re-fires
/// when the last firing is old enough.
model SlaFiring {
  id       String   @id @default(cuid())
  rule     SlaRule  @relation(fields: [ruleId], references: [id])
  ruleId   String
  entityId String
  firedAt  DateTime @default(now())

  @@index([ruleId, entityId, firedAt])
  @@map("sla_firings")
}

/// Public holidays — excluded (with Fri/Sat weekends) from working-day math.
model Holiday {
  id   String   @id @default(cuid())
  date DateTime @unique @db.Date
  name String

  @@map("holidays")
}

/// Named atomic counters. EMPLOYEE_NO backs employee-number allocation:
/// the value is incremented inside the activation transaction, so two
/// concurrent approvals can never mint the same number (the old count()+1
/// approach could).
model Sequence {
  key   String @id
  value Int

  @@map("sequences")
}

/// Admin-editable system settings (JSON values keyed by area, e.g. "mail").
model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("settings")
}

/// Which role group(s) own the records sitting in a given status of a given
/// state machine — editable from the admin screen. Seeded from the BRD
/// defaults; the machines' hardcoded roles are only the fallback when a row
/// is missing. ADMIN always passes regardless.
model StatusOwnership {
  id         String   @id @default(cuid())
  processKey String // TRAINEE | GOSI | MEDICAL_INSURANCE | CRIMINAL_RECORD | ASSET_FORM | OFFBOARDING
  status     String
  roles      Json // e.g. ["INSURANCE"] or ["HR","INSURANCE"]
  updatedAt  DateTime @updatedAt

  @@unique([processKey, status])
  @@map("status_ownership")
}

// ---------------------------------------------------------------------------
// Notifications, signed links, audit
// ---------------------------------------------------------------------------

model Notification {
  id             String              @id @default(cuid())
  channel        NotificationChannel
  status         NotificationStatus  @default(PENDING)
  /// Staff recipient (in-app + email) …
  recipient      User?               @relation(fields: [recipientUserId], references: [id])
  recipientUserId String?
  /// … or external recipient (trainee/employee) by email.
  recipientEmail String?
  locale         String              @default("ar")
  subject        String?
  body           String              @db.Text
  entity         String? // e.g. TRAINEE, ASSET_FORM — for deep links
  entityId       String?
  sentAt         DateTime?
  readAt         DateTime? // in-app read marker
  createdAt      DateTime            @default(now())

  @@index([recipientUserId, readAt])
  @@map("notifications")
}

/// Expiry-tracked identity/legal documents (Iqama, passport, contract end
/// date, …). The SLA engine watches expiryDate and reminds/escalates the
/// configured days ahead.
model EmployeeDocument {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
  type       String // IQAMA | NATIONAL_ID | PASSPORT | CONTRACT | WORK_PERMIT | ...
  number     String?
  expiryDate DateTime @db.Date
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId])
  @@index([expiryDate])
  @@map("employee_documents")
}

/// Signed single-purpose link (trainee/employee actions). Only the token
/// hash is stored — the raw token exists only inside the email we send.
model LinkToken {
  id      String      @id @default(cuid())
  purpose LinkPurpose

  employee      Employee?    @relation(fields: [employeeId], references: [id])
  employeeId    String?
  assetForm     AssetForm?   @relation(fields: [assetFormId], references: [id])
  assetFormId   String?
  offboarding   Offboarding? @relation(fields: [offboardingId], references: [id])
  offboardingId String?

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([employeeId])
  @@map("link_tokens")
}

/// Append-only audit trail — every status transition, SLA action, and
/// e-approval across all state machines. Never updated, never deleted.
model AuditLog {
  id       String @id @default(cuid())
  entity   String // EMPLOYEE | GOSI | MEDICAL_INSURANCE | CRIMINAL_RECORD | ASSET_FORM | OFFBOARDING | EMPLOYEE_REQUEST
  entityId String
  action   String // STATUS_TRANSITION | SLA_REMINDER | SLA_EXPIRE | LINK_SENT | E_APPROVAL | REOPEN | ...

  fromStatus String?
  toStatus   String?

  actorType String // USER | LINK | SYSTEM
  actor     User?   @relation(fields: [actorId], references: [id])
  actorId   String?

  /// Optional anchor so a record's full timeline is one indexed query.
  employee   Employee? @relation("EmployeeAudit", fields: [employeeId], references: [id])
  employeeId String?

  metadata Json?
  at       DateTime @default(now())

  @@index([entity, entityId])
  @@index([employeeId, at])
  @@map("audit_logs")
}
