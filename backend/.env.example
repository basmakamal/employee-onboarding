# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database: XAMPP MySQL/MariaDB. Use 127.0.0.1 (NOT localhost) on Windows. ---
DATABASE_URL=mysql://root:@127.0.0.1:3306/employee_onboarding

# --- Auth (Phase 5) ---
JWT_ACCESS_SECRET=change-me-in-real-env
JWT_REFRESH_SECRET=change-me-too

# --- SLA engine: minutes between rule scans (0 disables) ---
SLA_TICK_MINUTES=5

# --- Signed links & uploads ---
APP_URL=http://localhost:3000
UPLOAD_DIR=./storage
LINK_TTL_HOURS=240

# --- Email via Microsoft (Office 365 / Exchange) SMTP ---
# In development, NOTIFIER=console logs mail instead of sending it.
NOTIFIER=console
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=onboarding@example.com

# Redis (optional): enables the mail queue, worker-run SLA engine and
# revocable refresh tokens. Run 'npm run worker' alongside the API when set.
# REDIS_URL=redis://127.0.0.1:6379
# SLA_BATCH_SIZE=500
# AI_REDACT_PII=true
