# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database (docker-compose maps host port 5433 -> container 5432) ---
DATABASE_URL=postgresql://onboarding:onboarding@localhost:5433/onboarding

# --- Auth (Phase 5) ---
JWT_ACCESS_SECRET=change-me-in-real-env
JWT_REFRESH_SECRET=change-me-too

# --- Email via Microsoft (Office 365 / Exchange) SMTP (Phase 4) ---
# In development, NOTIFIER=console logs mail instead of sending it.
NOTIFIER=console
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=onboarding@example.com
